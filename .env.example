# Seclyst local configuration. Copy this file to .env and keep .env private.

# Optional internal port overrides.
SECLYST_MALWARE_PORT=7101
SECLYST_IOC_PORT=7102
SECLYST_EVENTS_PORT=7103
SECLYST_PHISHING_PORT=7104
SECLYST_RULEFORGE_PORT=7105

# Phase-gated control-plane services.
SECLYST_DURABLE_JOBS=true
SECLYST_PROVIDER_BROKER=false
SECLYST_JOB_LEASE_SECONDS=30
# SECLYST_DATABASE_PATH=runtime/seclyst.db

# Optional provider credentials inherited by copied engines.
VT_API_KEY=
HA_API_KEY=
TRIAGE_API_KEY=
FILESCAN_API_KEY=
URL_SCAN_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
OTX_API_KEY=
GREYNOISE_API_KEY=
CENSYS_API_KEY=
IPINFO_API_KEY=
NVD_API_KEY=
ETHERSCAN_API_KEY=

# Active network actions stay disabled unless deliberately enabled.
ENABLE_ACTIVE_PORT_SCAN=false
ENABLE_URL_CONTENT_FETCH=false
ENABLE_PUBLIC_URL_SUBMISSION=false
WEBHOOKS_ENABLED=false
